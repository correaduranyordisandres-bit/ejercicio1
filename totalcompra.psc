Algoritmo totalcompra
	Definir precio, cantidad, total Como Real
	Escribir "ingrese el precio del articulo";
	Leer precio
	Escribir "ingrese la cantidad que lleva el cliente";
	Leer cantidad
	total <- precio * cantidad 
	Escribir "el total que debe pagar el comprador es: $", total;
	
	

	
FinAlgoritmo
